{
  "expo": {
    "name": "PocketSalon",
    "slug": "pocket-salon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nativewind-expo-router",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "automatic",
      "requireFullScreen": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to take photos for hair analysis.",
        "NSPhotoLibraryUsageDescription": "This app accesses your photos to let you select images for hair analysis."
      },
      "bundleIdentifier": "com.pocketsalon.app"
    },
    "android": {
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.pocketsalon.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PocketSalon to access your camera for hair type detection."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PocketSalon to access your photos for hair type analysis."
        }
      ],
      "expo-sqlite",
      "expo-web-browser"
    ],
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "73447ed6-23eb-4a82-a320-866fe1c5a315"
      }
    }
  }
}
