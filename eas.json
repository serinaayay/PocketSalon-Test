        "EXPO_PUBLIC_SYNC_URL": "http://YOUR_COMPUTER_LAN_IP:4000"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SYNC_URL": "https://pocketsalon-upload-838334574163.us-central1.run.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
